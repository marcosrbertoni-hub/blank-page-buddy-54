{
  "name": "skyline-city",
  "version": "1.0.0",
  "type": "module",
  "description": "Skyline City - desktop city builder",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5180",
    "build": "vite build",
    "build:win": "npm run build && electron-builder --win portable --x64",
    "preview": "vite preview --port 5174",
    "shot": "node tools/shot.mjs",
    "check": "node tools/check.mjs",
    "build:win:low": "npm run build && electron-builder --win portable --x64 -c.extraMetadata.lowMode=true -c.win.artifactName=Skyline-City-Low.exe"
  },
  "devDependencies": {
    "electron": "44.4.5",
    "electron-builder": "26.15.3",
    "puppeteer-core": "^25.9.0",
    "three": "^0.185.1",
    "vite": "^8.2.2"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/marcosrbertoni-hub/blank-page-buddy-54.git"
  },
  "homepage": "https://blank-page-buddy-54.lovable.app",
  "engines": {
    "node": ">=20.19"
  },
  "build": {
    "appId": "com.skylinecity.game",
    "productName": "Skyline City",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Skyline-City-Windows.${ext}"
    }
  }
}
